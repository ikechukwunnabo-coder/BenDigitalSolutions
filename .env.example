# Ben Digital Solutions — environment template
# Copy to .env and fill in real values locally. Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL
POSTGRES_DB=ben_digital_solutions
POSTGRES_USER=ben_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Reserved for later phases — do not activate during Version 1
# BREVO_API_KEY=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# OPENAI_API_KEY=
# N8N_WEBHOOK_URL=

# Security notes
# 1. Generate the secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use different credentials for local and production.
# 3. Production requires DJANGO_DEBUG=False and real ALLOWED_HOSTS with HTTPS.
