# Ben Digital Solutions — environment template
# Copy to .env (project root) or backend/.env and fill in real values.
# Never commit a populated .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# Leave unset/empty to use local SQLite (backend/db.sqlite3).
# PostgreSQL example: postgresql://user:password@127.0.0.1:5432/bds
DATABASE_URL=

# Frontend (Vite build/runtime)
VITE_API_BASE_URL=http://127.0.0.1:8081/api

# Auth / CORS / CSRF (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production only: set True when served over HTTPS
# SECURE_COOKIES=True

# Reserved for later phases — do not activate during Version 1
# BREVO_API_KEY=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# OPENAI_API_KEY=
# N8N_WEBHOOK_URL=

# Security notes
# 1. Generate the secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use different credentials for local and production.
# 3. Production requires DJANGO_DEBUG=False, real ALLOWED_HOSTS and HTTPS.
